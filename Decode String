// LeetCode 394: Decode String
// Difficulty: Medium
// Topic: Stack, String
// Approach:
// Use two stacks: one for numbers and one for strings.
// When '[' appears push state.
// When ']' appears repeat the substring.
// Time Complexity: O(n)
// Space Complexity: O(n)

class Solution {
public:
    string decodeString(string s) {

        stack<int> countStack;
        stack<string> stringStack;

        string curr = "";
        int num = 0;

        for(char c : s){

            if(isdigit(c)){
                num = num * 10 + (c - '0');
            }

            else if(c == '['){
                countStack.push(num);
                stringStack.push(curr);
                num = 0;
                curr = "";
            }

            else if(c == ']'){
                int repeat = countStack.top();
                countStack.pop();

                string prev = stringStack.top();
                stringStack.pop();

                for(int i=0;i<repeat;i++)
                    prev += curr;

                curr = prev;
            }

            else{
                curr += c;
            }
        }

        return curr;
    }
};
