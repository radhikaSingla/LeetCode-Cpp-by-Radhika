// LeetCode 11: Container With Most Water
// Difficulty: Medium
// Topic: Two Pointers, Array
// Approach:
// Use two pointers at the start and end of the array.
// Calculate area using the smaller height and width between pointers.
// Move the pointer with smaller height inward to maximize area.
// Time Complexity: O(n)
// Space Complexity: O(1)

class Solution {
public:
    int maxArea(vector<int>& height) {
        int n = height.size();
        int i = 0 , j = n-1 ;
        int maxWater = 0;
        while(i<j){
            int w = j-i;
            int h = min(height[i], height[j]);
            int area = w * h;
            maxWater = max(maxWater , area);
            if(height[i] > height[j]){
                j--;
            }else{
                i++;
            }
        } return maxWater ;
    } 
};   
    
