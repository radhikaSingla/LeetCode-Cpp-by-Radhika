// LeetCode 12: Integer to Roman
// Difficulty: Medium
// Topic: Greedy, String
// Approach:
// Store Roman numeral values in descending order.
// Repeatedly subtract the largest possible value from num
// and append the corresponding Roman symbol.
// Time Complexity: O(1)   (constant because values are fixed)
// Space Complexity: O(1)

class Solution {
public:
    string intToRoman(int num) {
        string res = "";
        string symbol[]={"M","CM","D","CD","C","XC","L","XL","X","IX","V","IV","I"};
        
        int val[]={1000,900,500,400,100,90,50,40,10,9,5,4,1};
        for(int i=0;num!=0;i++)
        {
            while(num>=val[i])
            {
                num-=val[i];
                res+=symbol[i];
            }
        }
        return res;
    }
};
