// LeetCode 7: Reverse Integer
// Difficulty: Medium
// Topic: Math
// Approach:
// Pop digits from the number and push into a reversed number.
// Before pushing, check for overflow/underflow against INT limits.
// Time Complexity: O(log10(n))
// Space Complexity: O(1)

class Solution {
public:
    int reverse(int x) {
        int ans = 0;
        while(x!=0)
        {
            if((ans>INT_MAX/10) || (ans<INT_MIN/10))
            {
                return 0 ;
            }
            int digit = x%10;
            ans = (ans*10)+digit;
            x = x/10;
        }
        return ans;
    }
};
