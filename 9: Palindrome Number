// LeetCode 9: Palindrome Number
// Difficulty: Easy
// Topic: Math
// Approach:
// Reverse only half of the number and compare it with the remaining half.
// This avoids integer overflow and extra space.
// Time Complexity: O(log10(n))
// Space Complexity: O(1)

class Solution {
public:
bool isPalindrome(int x){
            if(x<0)
            {
                return false;
            }
            long ans = 0;
            int xcopy = x;
        while(x>0)
        {
            int digit = x % 10;
            ans = (ans * 10) + digit;
            x = x/ 10;
        }
        return xcopy == ans;
    }
    };

