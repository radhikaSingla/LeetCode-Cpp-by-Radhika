// LeetCode 3600: Maximize Spanning Tree Stability with Upgrades
// Difficulty: Hard
// Topic: Graph, Union-Find, Binary Search
// Time Complexity: O(E log W)
// Space Complexity: O(N)

class DSU {
public:
    vector<int> parent, rank;

    DSU(int n){
        parent.resize(n);
        rank.resize(n,0);
        for(int i=0;i<n;i++) parent[i]=i;
    }

    int find(int x){
        if(parent[x]==x) return x;
        return parent[x]=find(parent[x]);
    }

    bool unite(int a,int b){
        a=find(a);
        b=find(b);

        if(a==b) return false;

        if(rank[a]<rank[b]) swap(a,b);
        parent[b]=a;

        if(rank[a]==rank[b]) rank[a]++;

        return true;
    }
};

class Solution {
public:

    bool can(int n, vector<vector<int>>& edges, int k, int target){

        DSU dsu(n);
        int usedUpgrade = 0;
        int usedEdges = 0;

        vector<vector<int>> needUpgrade;

        // must edges
        for(auto &e: edges){
            int u=e[0], v=e[1], w=e[2], must=e[3];

            if(must==1){
                if(w < target) return false;
                if(!dsu.unite(u,v)) return false;
                usedEdges++;
            }
        }

        // optional edges (no upgrade needed)
        for(auto &e: edges){
            int u=e[0], v=e[1], w=e[2], must=e[3];

            if(must==0){
                if(w >= target){
                    if(dsu.unite(u,v))
                        usedEdges++;
                }
                else if(w*2 >= target){
                    needUpgrade.push_back(e);
                }
            }
        }

        // optional edges with upgrade
        for(auto &e: needUpgrade){

            if(usedUpgrade == k) break;

            int u=e[0], v=e[1];

            if(dsu.unite(u,v)){
                usedUpgrade++;
                usedEdges++;
            }
        }

        return usedEdges == n-1;
    }

    int maxStability(int n, vector<vector<int>>& edges, int k) {

        int left = 0, right = 1e9;
        int ans = -1;

        while(left <= right){

            int mid = left + (right-left)/2;

            if(can(n, edges, k, mid)){
                ans = mid;
                left = mid + 1;
            }
            else{
                right = mid - 1;
            }
        }

        return ans;
    }
};
